# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chintamani_jewellers?schema=public"

# Authentication (Change to a 32+ char random secret in production)
JWT_SECRET="chintamani-dev-jwt-secret-change-in-production-32chars"

# Razorpay Payment Gateway (Leave blank for safe Demo Payment Verification mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Authorised Live Metal-Rate API (Optional - falls back to Admin-configured manual rates)
METAL_RATE_API_URL=""
METAL_RATE_API_KEY=""

# Cloudinary Image Storage (Optional - local upload / URL supported)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notifications (Email & WhatsApp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@chintamanijewellers.example"

# Public Site & Analytics
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Admin Seed Credentials (Used by prisma/seed.ts & demo store)
ADMIN_EMAIL="admin@chintamanijewellers.in"
ADMIN_PASSWORD="ChangeMe@2026!"
